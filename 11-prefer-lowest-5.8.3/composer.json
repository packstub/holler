{
    "name": "packstub/filament-calls",
    "description": "Audio, video and screen-share calls inside a Filament panel, 1-on-1 or in groups of up to four, peer to peer over WebRTC: a CallAction for any user record and a call widget on every page. The media goes browser to browser; polling signaling, no websockets. The panel side of packstub/calls.",
    "keywords": [
        "packstub",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v4",
        "filament-v5",
        "webrtc",
        "video-call",
        "voice-call",
        "screen-share",
        "group-call",
        "peer-to-peer",
        "livewire"
    ],
    "homepage": "https://github.com/packstub/filament-calls",
    "support": {
        "issues": "https://github.com/packstub/filament-calls/issues",
        "source": "https://github.com/packstub/filament-calls",
        "docs": "https://packstub.dev/docs/filament-calls"
    },
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "filament/filament": "^4.13.3 || ^5.8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "packstub/calls": "^1.0",
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/Users/ioncaliman/workplace/my-projects/packstub/plugins/calls",
            "options": {
                "symlink": true,
                "versions": {
                    "packstub/calls": "1.0.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Packstub\\FilamentCalls\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\FilamentCalls\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "test:e2e": "npm run test:e2e --",
        "lint": "pint",
        "lint:test": "pint --test",
        "build:js": "npm run build:js",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\FilamentCalls\\FilamentCallsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
