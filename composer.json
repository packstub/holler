{
    "name": "packstub/calls",
    "description": "1-on-1 audio, video and screen-share calls between the users of a Laravel app, peer to peer over WebRTC: the media goes browser to browser, Laravel only handles who calls whom and relays the few signaling messages over polled HTTP. No websockets. packstub/filament-calls adds the panel UI.",
    "keywords": [
        "packstub",
        "laravel",
        "webrtc",
        "video-call",
        "voice-call",
        "screen-share",
        "peer-to-peer",
        "signaling"
    ],
    "homepage": "https://github.com/packstub/calls",
    "support": {
        "issues": "https://github.com/packstub/calls/issues",
        "source": "https://github.com/packstub/calls",
        "docs": "https://packstub.dev/docs/calls"
    },
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Calls\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Calls\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Calls\\CallsServiceProvider"
            ],
            "aliases": {
                "Calls": "Packstub\\Calls\\Facades\\Calls"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
