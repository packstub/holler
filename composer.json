{
    "name": "packstub/holler",
    "description": "Audio, video and screen-share calls between the users of a Laravel app, one on one or in small groups, peer to peer over WebRTC. Laravel only handles who calls whom and relays the signaling over polled HTTP, no websockets; a Blade widget and button put calls on any page, and guests and call kinds let another package build on it. packstub/filament-holler adds a Filament panel UI.",
    "keywords": [
        "packstub",
        "laravel",
        "webrtc",
        "video-call",
        "voice-call",
        "screen-share",
        "group-call",
        "peer-to-peer",
        "signaling",
        "blade"
    ],
    "homepage": "https://github.com/packstub/holler",
    "support": {
        "issues": "https://github.com/packstub/holler/issues",
        "source": "https://github.com/packstub/holler",
        "docs": "https://packstub.dev/docs/holler"
    },
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.69 || ^13.30",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7.8 || ^5.3.4",
        "pestphp/pest-plugin-browser": "^4.3 || ^5.2"
    },
    "suggest": {
        "packstub/filament-holler": "The same calls inside a Filament panel: a CallAction, a widget and a pop-out window drawn with Filament's components"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Holler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Holler\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --testsuite=Feature",
        "test:filter": "pest --testsuite=Feature --filter",
        "test:browser": "pest --testsuite=Browser",
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Holler\\HollerServiceProvider"
            ],
            "aliases": {
                "Holler": "Packstub\\Holler\\Facades\\Holler"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
